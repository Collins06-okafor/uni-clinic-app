APP_NAME="ClinicFlow Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Branding ──────────────────────────────────────────
INSTITUTION_NAME="Your University Name"
INSTITUTION_SHORT="UNI"
SUPPORT_EMAIL=admin@yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Allowed email domains for student/staff registration
# Comma-separated list, e.g. "university.edu,student.myuni.edu"
# Leave blank to allow ANY email domain
ALLOWED_EMAIL_DOMAINS=

# ── Clinic Hours ──────────────────────────────────────
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=17:00
CLINIC_DAYS_START=1
CLINIC_DAYS_END=5

# ── Database ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinicflow
DB_USERNAME=root
DB_PASSWORD=

# ── Session ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Mail ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${INSTITUTION_NAME} Clinic"

# ── Google OAuth (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Broadcasting / Queue ──────────────────────────────
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Misc ──────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"